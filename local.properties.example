# Optional cloud-sync configuration.
# Copy these keys into local.properties (which is gitignored) and fill in the values.
# Cloud sync stays disabled while they are blank.

# Firebase project (Project settings -> General -> Your apps)
firebase.projectId=
firebase.applicationId=
firebase.apiKey=

# Project number (Project settings -> General), used for update push messages
firebase.senderId=

# Web client OAuth ID (Authentication -> Google -> Web SDK configuration)
google.webClientId=
